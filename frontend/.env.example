# Backend API endpoint
PUBLIC_API_BASE_URL=https://api.vitevue.com

# Supabase Auth endpoint
PUBLIC_AUTH_BASE_URL=https://auth.vitevue.com

# Stripe publishable key (safe to expose to browser)
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key

# PostHog Analytics (optional)
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
PUBLIC_POSTHOG_KEY=phc_your_posthog_key
