{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vv-pilot",
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	"compatibility_date": "2026-01-14",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"PUBLIC_API_BASE_URL": "https://api-pilot.vitevue.com",
		"PUBLIC_AUTH_BASE_URL": "https://auth-pilot.vitevue.com",
		"PUBLIC_AUTH_PUBLISHABLE_KEY": "",
		"PUBLIC_CRM_PRESENTATION_MODE": "true",
		"PUBLIC_POSTHOG_KEY": "",
		"PUBLIC_POSTHOG_HOST": ""
	}
}
