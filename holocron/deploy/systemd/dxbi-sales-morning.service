[Unit]
Description=ViteVue morning DXBI sales re-scrape of the last 3 days (back-fills the units DXBI adds)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/repos/vitevue-platform
ExecStart=/usr/local/sbin/dxbi-report-daily sales morning
TimeoutStartSec=95min
Nice=5
