# Holocron VPS runtime
#
# The VPS only runs Dagster. Durable state lives outside the VPS:
# - Dagster run/event/schedule metadata in external Postgres
# - raw releases and manifests in Cloudflare R2
# - bronze warehouse tables in external ClickHouse

DAGSTER_PORT=3000
DAGSTER_POSTGRES_URL=postgresql://user:password@postgres-host:5432/dagster

# Cloudflare R2 raw release storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET=vitevue-etl
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_USE_PATH_STYLE=true
R2_PUBLIC_URL_BASE=

# External ClickHouse warehouse
CLICKHOUSE_HOST=clickhouse-host
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=vitevue
CLICKHOUSE_SECURE=true

# Optional source credentials
REELLY_EMAIL=
REELLY_PASSWORD=
TWOCAPTCHA_API_KEY=

# Platform news ingestion
PLATFORM_POSTGRES_URL=
NEWS_FEED_URLS=
NEWS_THUMBNAIL_PREFIX=media/news/thumbnails
