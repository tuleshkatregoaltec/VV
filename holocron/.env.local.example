# Local Dagster metadata storage
DAGSTER_POSTGRES_URL=postgresql://dagster:dagster@postgres:5432/dagster

# Local MinIO-backed R2-compatible object storage
R2_ACCESS_KEY_ID=minio
R2_SECRET_ACCESS_KEY=minio123
R2_REGION=us-east-1
R2_BUCKET=vitevue-etl
R2_ENDPOINT_URL=http://minio:9000
R2_USE_PATH_STYLE=true
R2_PUBLIC_URL_BASE=

# Local ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=vitevue
CLICKHOUSE_SECURE=false

# Source configuration
REELLY_EMAIL=
REELLY_PASSWORD=
TWOCAPTCHA_API_KEY=

# Platform news ingestion
PLATFORM_POSTGRES_URL=
NEWS_FEED_URLS=
NEWS_THUMBNAIL_PREFIX=media/news/thumbnails
