# Local Dagster metadata storage
DAGSTER_POSTGRES_URL=postgresql://dagster:dagster@postgres:5432/dagster

# Local MinIO-backed S3 mock
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
AWS_REGION=us-east-1
S3_BUCKET=vitevue-etl
S3_ENDPOINT_URL=http://minio:9000
S3_USE_PATH_STYLE=true
S3_PUBLIC_URL_BASE=

# Local ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=vitevue
CLICKHOUSE_SECURE=false

# Source configuration
DLD_BASE_URL=
DLD_API_KEY=
GIS_BASE_URL=
GEO_BUILDINGS_URL=

# Platform news ingestion
PLATFORM_POSTGRES_URL=
NEWS_FEED_URLS=
NEWS_THUMBNAIL_PREFIX=media/images/news/thumbnails
