  "get_project_delivery_summary": {
    "description": "DLD project/unit counts by developer/status/year/project; distinguishes missing/overdue/scheduled delivery. Defaults to ACTIVE and scheduled_in_horizon for the next 24 months. Select missing_date/overdue/scheduled_later explicitly for audits; by_delivery_status also describes all categories. Scheduled dates are not delivery guarantees.",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "request": {
          "additionalProperties": false,
          "properties": {
            "delivery_statuses": {
              "items": {
                "enum": [
                  "missing_date",
                  "overdue",
                  "scheduled_in_horizon",
                  "scheduled_later",
                  "completed",
                  "cancelled"
                ],
                "type": "string"
              },
              "maxItems": 6,
              "minItems": 1,
              "title": "Delivery Statuses",
              "type": "array"
            },
            "group_by": {
              "default": "developer",
              "enum": [
                "developer",
                "delivery_status",
                "delivery_year",
                "project"
              ],
              "title": "Group By",
              "type": "string"
            },
            "horizon_months": {
              "default": 24,
              "maximum": 120,
              "minimum": 1,
              "title": "Horizon Months",
              "type": "integer"
            },
            "limit": {
              "default": 20,
              "maximum": 50,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            },
            "location": {
              "anyOf": [
                {
                  "maxLength": 120,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Location"
            },
            "project_statuses": {
              "items": {
                "enum": [
                  "ACTIVE",
                  "NOT_STARTED",
                  "PENDING",
                  "FINISHED"
                ],
                "type": "string"
              },
              "maxItems": 4,
              "title": "Project Statuses",
              "type": "array"
            }
          },
          "title": "DeliveryRequest",
          "type": "object"
        }
      },
      "required": [
        "request"
      ],
      "type": "object"
    }
  },
