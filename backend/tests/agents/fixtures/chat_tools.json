{
  "compare_listing_age": {
    "description": "Sale listings older than a threshold at capture, with unknown ages separately. Compare exact building, bedrooms, property type and 100-sqft size-band newer peers. Posting, first-observation and capture dates are distinct.",
    "schema": {
      "additionalProperties": false,
      "properties": {
        "request": {
          "additionalProperties": false,
          "properties": {
            "bedrooms": {
              "anyOf": [
                {
                  "enum": [
                    "studio",
                    "1",
                    "2",
                    "3",
                    "4",
                    "5",
                    "6",
                    "7"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Bedrooms"
            },
            "building": {
              "anyOf": [
                {
                  "maxLength": 160,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Building"
            },
            "limit": {
              "default": 10,
              "maximum": 20,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            },
            "location": {
              "anyOf": [
                {
                  "maxLength": 120,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Location"
            },
            "mode": {
              "const": "sale",
              "default": "sale",
              "title": "Mode",
              "type": "string"
            },
            "older_than_days": {
              "default": 90,
              "maximum": 3660,
              "minimum": 1,
              "title": "Older Than Days",
              "type": "integer"
            },
            "price_max": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "maximum": 1000000000,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Price Max"
            },
            "property_type": {
              "default": "Apartment",
              "enum": [
                "Apartment",
                "Villa",
                "Townhouse",
                "Office",
                "Shop"
              ],
              "title": "Property Type",
              "type": "string"
            }
          },
          "title": "ListingAgeRequest",
          "type": "object"
        }
      },
      "required": [
        "request"
      ],
      "type": "object"
    }
  },
  "compare_listing_rents": {
    "description": "Bounded sale listings with comparable registered annual-rent evidence, samples and supported gross-yield IQR. Requires known bedrooms; no silent building fallback. Estimates are withheld without a pinned shared release, complete coverage and at least five contracts.",
    "schema": {
      "$defs": {
        "MarketPeriodRequest": {
          "additionalProperties": false,
          "description": "A calendar period, resolved in the Asia/Dubai business timezone.\n\nprevious_month: the calendar month before the reference date's month (\"last month\").\nprevious_quarter: the calendar quarter before (\"last quarter\").\nprevious_months: `months` complete calendar months ending with the previous month.\nmonth / quarter: explicit \"YYYY-MM\" / \"YYYY-Qn\".\nrolling_days: `days` calendar days ending on the reference date (\"last 90 days\").\nrange: explicit inclusive start/end.",
          "properties": {
            "days": {
              "anyOf": [
                {
                  "maximum": 3660,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Days"
            },
            "end": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "End"
            },
            "month": {
              "anyOf": [
                {
                  "pattern": "^\\d{4}-\\d{2}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Month"
            },
            "months": {
              "anyOf": [
                {
                  "maximum": 120,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Months"
            },
            "quarter": {
              "anyOf": [
                {
                  "pattern": "^\\d{4}-[Qq][1-4]$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Quarter"
            },
            "start": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Start"
            },
            "type": {
              "enum": [
                "previous_month",
                "previous_quarter",
                "previous_months",
                "month",
                "quarter",
                "rolling_days",
                "range"
              ],
              "title": "Type",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "title": "MarketPeriodRequest",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "request": {
          "additionalProperties": false,
          "properties": {
            "bedrooms": {
              "enum": [
                "studio",
                "1",
                "2",
                "3",
                "4",
                "5",
                "6",
                "7"
              ],
              "title": "Bedrooms",
              "type": "string"
            },
            "building": {
              "anyOf": [
                {
                  "maxLength": 160,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Building"
            },
            "limit": {
              "default": 5,
              "maximum": 8,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            },
            "location": {
              "maxLength": 120,
              "minLength": 1,
              "title": "Location",
              "type": "string"
            },
            "mode": {
              "const": "sale",
              "default": "sale",
              "title": "Mode",
              "type": "string"
            },
            "period": {
              "$ref": "#/$defs/MarketPeriodRequest"
            },
            "price_max": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "maximum": 1000000000,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Price Max"
            },
            "property_type": {
              "default": "Apartment",
              "enum": [
                "Apartment",
                "Villa",
                "Office",
                "Shop"
              ],
              "title": "Property Type",
              "type": "string"
            }
          },
          "required": [
            "location",
            "bedrooms"
          ],
          "title": "ListingRentRequest",
          "type": "object"
        }
      },
      "required": [
        "request"
      ],
      "type": "object"
    }
  },
