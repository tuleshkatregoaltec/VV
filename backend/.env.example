# Database
DATABASE_URL=postgresql+asyncpg://something:something@something:something/something

# Redis
REDIS_URL=redis://something:something
REDIS_PASSWORD=something

# WorkOS (Legacy - may be deprecated)
WORKOS_API_KEY=something
WORKOS_CLIENT_ID=something
WORKOS_REDIRECT_URI=http://something:something/auth/callback

# Frontend URL
FRONTEND_URL=http://something:something

# Security
SESSION_SECRET=atleast32charssomething
SERVICE_API_KEY=atleast32charssomething

# CORS
ALLOWED_ORIGINS='["http://something:something"]'

# Error Tracking
HONEYBADGER_API_KEY=something

# OpenRouter (AI Chat)
OPENROUTER_API_KEY=something
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHAT_MODEL=anthropic/claude-3-haiku

# Supabase Auth
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=something
AUTH_URL=https://something.supabase.co/auth/v1

# PostHog Analytics
POSTHOG_API_KEY=phc_something
POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare R2 / S3 Storage
R2_ENDPOINT_URL=https://something.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=something
R2_SECRET_ACCESS_KEY=something
R2_BUCKET_NAME=something
R2_REGION=auto

# ClickHouse (Analytics Database)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=default

# Stripe Payment Integration
STRIPE_SECRET_KEY=sk_test_something
STRIPE_PUBLISHABLE_KEY=pk_test_something
STRIPE_WEBHOOK_SECRET=whsec_something
STRIPE_PRICE_ID_TIER1=price_something  # 990 AED/seat for 1-5 seats
STRIPE_PRICE_ID_TIER2=price_something  # 890 AED/seat for 6-10 seats

# Frontend URLs for Stripe Redirects
FRONTEND_SUCCESS_URL=http://something:something/onboarding/payment-success
FRONTEND_CANCEL_URL=http://something:something/onboarding/payment-cancel

# Enterprise Contact
ENTERPRISE_CONTACT_EMAIL=contact@vitevue.com