# Dagster metadata storage (AWS Postgres)
DAGSTER_POSTGRES_URL=postgresql://user:password@host:5432/dagster

# AWS / S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=vitevue-etl
S3_ENDPOINT_URL=
S3_USE_PATH_STYLE=false

# ClickHouse
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=vitevue
CLICKHOUSE_SECURE=true

# DLD source credentials (fill in when available)
DLD_BASE_URL=
DLD_API_KEY=

# GIS source credentials
GIS_BASE_URL=

# Optional geo release input
GEO_BUILDINGS_URL=
