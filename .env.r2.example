# Temporary raw-only VPS smoke test against an R2 bucket.
#
# This is not the production shape. It uses a local Docker Postgres only for
# Dagster metadata, writes raw releases/manifests to R2, and should only run raw
# assets. Do not run bronze jobs unless real ClickHouse values are configured.

DAGSTER_PORT=3000
DAGSTER_POSTGRES_URL=postgresql://dagster:dagster@postgres:5432/dagster

# Cloudflare R2 S3-compatible storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
S3_BUCKET=
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_USE_PATH_STYLE=true
S3_PUBLIC_URL_BASE=

# Optional source credentials for the raw assets you want to test
REELLY_EMAIL=
REELLY_PASSWORD=
TWOCAPTCHA_API_KEY=

# Optional news sync settings
PLATFORM_POSTGRES_URL=
NEWS_FEED_URLS=
NEWS_THUMBNAIL_PREFIX=media/images/news/thumbnails

# Dummy ClickHouse values. Raw-only tests do not connect to these.
CLICKHOUSE_HOST=unused
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=unused
CLICKHOUSE_DATABASE=default
CLICKHOUSE_SECURE=false
